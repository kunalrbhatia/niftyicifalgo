### 14. `index.js` — Main Orchestrator

**Full execution flow:**

```javascript
const { isTodayTradingDay } = require('./modules/holidayCheck');
const { login } = require('./modules/auth');
const { getExpiryDate } = require('./modules/expirySelector');
const { getNiftyCandles, getNiftySpotPrice } = require('./modules/candleData');
const { detectSignal } = require('./modules/rsiEngine');
const { getOptionChain } = require('./modules/optionChain');
const { pickSellStrike, pickHedgeStrike } = require('./modules/strikePicker');
const { placeSpreadEntry } = require('./modules/orderManager');
const { initPosition } = require('./modules/positionTracker');
const { startPnlMonitor, stopPnlMonitor } = require('./modules/pnlMonitor');
const { runForceExit } = require('./modules/exitManager');
const { isTimeReached, sleep } = require('./utils/helpers');
const logger = require('./utils/logger');
const config = require('./config');
const axios = require('axios');

async function fetchMarginUsed(jwtToken) {
  // Attempt to fetch RMS (Risk Management System) data for margin blocked
  try {
    const res = await axios.get(`${config.baseURL}/rest/secure/angelbroking/user/v1/getRMS`, {
      headers: {
        'Authorization': `Bearer ${jwtToken}`,
        'X-PrivateKey': process.env.ANGEL_API_KEY,
        'Content-Type': 'application/json',
      }
    });
    // Extract net available margin or use spread margin estimation as fallback
    const rmsData = res.data?.data;
    if (rmsData?.net) return parseFloat(rmsData.net);
  } catch (e) {
    logger.warn('RMS margin fetch failed. Using estimated margin.');
  }
  // Fallback: estimate 15% of notional value of short leg
  // Caller must pass sellStrike for fallback — handled in main()
  return null;
}

async function main() {
  logger.info('=== Nifty RSI Options Algo Started ===');

  // STEP 1: Check if today is a valid NSE trading day
  const isTradingDay = await isTodayTradingDay();
  if (!isTradingDay) {
    logger.info('Today is an NSE holiday or weekend. Algo exits.');
    process.exit(0);
  }
  logger.info('Today is a valid NSE trading day. Proceeding...');

  // STEP 2: Login
  logger.info('Logging into SmartAPI...');
  const session = await login();
  const { jwtToken } = session;
  logger.info('Login successful.');

  // STEP 3: Determine expiry date to trade
  const expiryDate = await getExpiryDate();
  logger.info(`Trading expiry: ${expiryDate}`);

  // STEP 4: Wait until entry monitoring start time (09:20 AM IST)
  while (!isTimeReached(config.entryStartTime)) {
    logger.info(`Waiting for entry start time ${config.entryStartTime}...`);
    await sleep(30 * 1000);
  }

  // STEP 5: RSI monitoring loop — runs every 1 minute until signal or cutoff
  let tradeTriggered = false;
  logger.info('Starting RSI monitoring loop (1-min interval, 5-min candles)...');

  while (!isTimeReached(config.entryCutoffTime) && !tradeTriggered) {
    try {
      // Fetch completed 5-min candles and compute RSI on latest close
      const candles = await getNiftyCandles(jwtToken);
      const { signal, rsi } = detectSignal(candles);
      logger.info(`RSI: ${rsi.toFixed(2)} | Signal: ${signal || 'NONE'}`);

      if (signal) {
        logger.info(`RSI signal detected: ${signal} at RSI=${rsi.toFixed(2)}`);

        // Fetch option chain and spot price
        const optionChain = await getOptionChain(jwtToken, expiryDate);
        const spotPrice = await getNiftySpotPrice(jwtToken);

        // Pick sell strike and hedge strike
        const sellStrike = pickSellStrike(signal, spotPrice, optionChain);
        if (!sellStrike) {
          logger.warn('No liquid sell strike found. Skipping signal, will retry next minute.');
          await sleep(config.rsiCheckIntervalMs);
          continue;
        }

        const hedgeStrike = pickHedgeStrike(signal, sellStrike, optionChain);
        if (!hedgeStrike) {
          logger.warn('No liquid hedge strike found. Skipping signal, will retry next minute.');
          await sleep(config.rsiCheckIntervalMs);
          continue;
        }

        logger.info(`Sell Strike: ${sellStrike.strikePrice} @ LTP ₹${sellStrike.ltp}`);
        logger.info(`Hedge Strike: ${hedgeStrike.strikePrice} @ LTP ₹${hedgeStrike.ltp}`);

        // Place the spread (sell + hedge)
        const quantity = config.lots * config.lotSize;
        const { sellOrderId, hedgeOrderId } = await placeSpreadEntry(jwtToken, {
          sellStrike,
          hedgeStrike,
          signal,
          quantity,
        });

        // Fetch margin used (or estimate fallback)
        let marginUsed = await fetchMarginUsed(jwtToken);
        if (!marginUsed) {
          // Fallback: 15% of notional value of the short leg
          marginUsed = sellStrike.strikePrice * config.lotSize * config.lots * 0.15;
          logger.warn(`Using estimated margin: ₹${marginUsed.toFixed(2)}`);
        }
        logger.info(`Margin used: ₹${marginUsed.toFixed(2)}`);
        logger.info(`Profit target: ₹${(marginUsed * config.profitTargetPct / 100).toFixed(2)} (+${config.profitTargetPct}%)`);
        logger.info(`Stop loss: ₹${(marginUsed * config.stoplossPct / 100).toFixed(2)} (-${config.stoplossPct}%)`);

        initPosition(signal, rsi, spotPrice, sellStrike, hedgeStrike, { sellOrderId, hedgeOrderId }, marginUsed, quantity);
        logger.info('Spread placed. Position initiated. RSI monitoring stopped. Starting P&L monitor...');

        // STEP 6: Start P&L monitor — will auto-exit on TP or SL
        startPnlMonitor(jwtToken);
        tradeTriggered = true;
      }
    } catch (err) {
      logger.error('Error in RSI monitoring loop:', err);
    }

    if (!tradeTriggered) {
      await sleep(config.rsiCheckIntervalMs); // wait 1 minute before next RSI check
    }
  }

  if (!tradeTriggered) {
    logger.info('No RSI signal before cutoff time. No trade placed today.');
  }

  // STEP 7: Wait until 3:25 PM hard exit time
  while (!isTimeReached(config.finalExitTime)) {
    await sleep(30 * 1000); // check every 30s for precision
  }

  // STEP 8: Force exit — stops P&L monitor and exits any remaining open position
  if (tradeTriggered) {
    logger.info('3:25 PM reached. Running force exit check...');
    stopPnlMonitor();
    await runForceExit(jwtToken);
  } else {
    logger.info('No positions to exit. Algo done for today.');
  }

  logger.info('=== Algo Completed for Today ===');
  process.exit(0);
}

main().catch((err) => {
  logger.error('Fatal error in main:', err);
  process.exit(1);
});
```

